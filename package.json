{
  "name": "interactive-beam-simulator",
  "version": "0.6.16",
  "private": true,
  "description": "Interactive 3D Beam Deflection & Structural Design Simulator (SNI 2847:2019 & SNI 1729:2020)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "wasm:build": "bun run scripts/wasm/build-mechanics-wasm.ts",
    "dev": "bun run sync-version && bun --bun next dev --turbopack",
    "build": "bun run sync-version && bun run wasm:build && bun check -b && bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun scripts/verify.ts",
    "lint:full": "bun scripts/verify.ts --build",
    "sync-version": "bun scripts/sync-version.ts",
    "commit": "bun scripts/release.ts",
    "typecheck": "bun check -b",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "format:staged": "bun fmt --staged",
    "test": "bun test --parallel --check",
    "commit:ai": "bun run scripts/ai/ai-commit-helper.ts",
    "pr:ai": "bun run scripts/ai/ai-pr-summary.ts",
    "hooks:install": "bun run scripts/ci/install-git-hooks.ts",
    "data:validate": "bun run scripts/data/validate-sni-catalogs.ts",
    "pwa:icons": "bun run scripts/pwa/generate-pwa-icons.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "gsap": "3.15.1",
    "katex": "0.19.1",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@rilaptra/tui": "1.0.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/bun": "1.4.4",
    "@types/katex": "0.16.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.4"
}
