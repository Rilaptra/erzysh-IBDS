# Set default behavior to use CRLF line endings
* text=auto eol=crlf

# Explicit text files
*.md text eol=crlf
*.json text eol=crlf
*.js text eol=crlf
*.ts text eol=crlf
*.tsx text eol=crlf
*.css text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
