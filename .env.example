# ==============================================================================
# INTERACTIVE BEAM DEFLECTION & STRUCTURAL DESIGN SIMULATOR (IBDS)
# GLOBAL ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONFIGURASI MODEL & SUARA GEMINI AI
# ------------------------------------------------------------------------------
# API Key Google Gemini (didapat dari https://aistudio.google.com/)
AI_PROVIDER_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model untuk Intent Router (Perintah Suara & Rekomendasi Saran Dinamis)
# Pilihan: gemini-2.5-flash (Direkomendasikan), gemini-2.5-pro, gemini-1.5-flash
GEMINI_INTENT_MODEL=gemini-2.5-flash

# Model untuk Asisten Konsultan Rekayasa Struktur & Chatbot SNI
# Pilihan: gemini-2.5-flash (Cepat), gemini-2.5-pro (Penalaran Rumit)
GEMINI_CONSULTANT_MODEL=gemini-2.5-flash

# Model untuk Gemini Live Audio Streaming (24kHz Native Voice WebSocket)
# Pilihan: models/gemini-3.8-live (Direkomendasikan), models/gemini-2.0-flash-exp
GEMINI_LIVE_MODEL=models/gemini-3.8-live

# Persona Suara untuk Respon Audio Gemini Live
# Pilihan: Aoede (Wanita Ramah/Melodis), Puck (Pria Santai), Charon (Pria Formal Teknik), Kore (Wanita Tenang), Fenrir (Pria Tegas)
GEMINI_LIVE_VOICE=Aoede

# Daftar Model Cadangan (Fallback jika model utama limit/kuota habis, pisahkan dengan koma)
AI_FALLBACK_MODELS=gemini-2.5-flash,gemini-1.5-flash

# Alias Model Umum (Backward Compatibility)
AI_COMMIT_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. PARAMETER DEFAULT SIMULASI STRUKTUR & BALOK
# ------------------------------------------------------------------------------
# Material Awal: STEEL (Baja SNI 1729) atau CONCRETE (Beton Bertulang SNI 2847)
NEXT_PUBLIC_DEFAULT_MATERIAL=STEEL

# Panjang Bentang Awal Balok (meter)
NEXT_PUBLIC_DEFAULT_SPAN_M=6.0

# Batas Lendutan Izin Denominator (L / X). Default: 360 (L/360)
NEXT_PUBLIC_DEFAULT_DEFLECTION_LIMIT_DENOMINATOR=360

# Profil Baja Standar Awal
NEXT_PUBLIC_DEFAULT_STEEL_PROFILE=IWF 300x150
NEXT_PUBLIC_DEFAULT_STEEL_GRADE=BJ_37

# Dimensi & Mutu Beton Bertulang Awal
NEXT_PUBLIC_DEFAULT_CONCRETE_FC_MPA=25
NEXT_PUBLIC_DEFAULT_CONCRETE_BW_MM=300
NEXT_PUBLIC_DEFAULT_CONCRETE_H_MM=600

# ------------------------------------------------------------------------------
# 3. WEBCAM & DETEKSI GESTUR TANGAN (MEDIAPIPE COMPUTER VISION)
# ------------------------------------------------------------------------------
# Target FPS Pengolahan Video Gestur (Rekomendasi: 15 untuk hemat CPU/baterai, 30 untuk ultra-smooth)
NEXT_PUBLIC_HAND_TRACKING_FPS=15

# Aktifkan Eco Mode penghemat daya saat tangan tidak aktif di kamera
NEXT_PUBLIC_HAND_TRACKING_ECO_MODE=true

# ------------------------------------------------------------------------------
# 4. GOOGLE ANALYTICS 4 (GA4) TELEMETRI PENGUNJUNG
# ------------------------------------------------------------------------------
# GA4 Measurement ID untuk pelacakan halaman publik
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# GA4 Data API Property ID & Service Account (Untuk counter pengunjung real-time)
GA4_PROPERTY_ID=123456789
GA4_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk@project.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# Nilai awal counter pengunjung jika kredensial GA4 belum dikonfigurasi
NEXT_PUBLIC_GA4_FALLBACK_VISITORS=1420
NEXT_PUBLIC_PROJECT_START_DATE=2026-11-01T00:00:00.000Z

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
